# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
report.html

# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
# 自部署时服务器端本地数据（nitro fs storage）
# localdata 是本地 pnpm dev 的默认目录，data/ 是 docker compose 的挂载目录
localdata
/data/
# 官方词典数据，约 430MB，用 scripts/fetch-dicts.py 下载，不进仓库
/dicts/
# 自建文章库的朗读音频，约 160MB，用 scripts/synth-article-audio.py 合成，不进仓库
/audio/
# Misc
.fleet

# Local env files
.env
.env.*
!.env.example
public/vscode
apps/TypeWordsMiniApp
*.tsbuildinfo

# 自建词库相关（scripts/build-word-dict.py、make-article-dict.py）
# 注意 gitignore 不支持行尾注释，注释必须单独一行
scripts/__pycache__/
# ECDICT csv 66MB，build-word-dict.py 的释义来源
build-cache/
# macOS 打包 tar 时留下的 AppleDouble 文件
._*
