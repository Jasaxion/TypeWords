# 复制到项目根目录的 .env 后使用：cp docker/env.example .env
# docker compose 会自动读取根目录的 .env

# 宿主机映射端口（SSR，默认）
TYPEWORDS_PORT=3000

# 站点对外访问地址（不要带结尾斜杠），用于生成绝对链接。
# 例：http://192.168.1.10:3000 或 https://words.example.com
ORIGIN=http://localhost:3000

# 部署在子路径时填写（需以 / 开头和结尾），根路径保持 /
NUXT_APP_BASE_URL=/

# 构建阶段 Node 堆上限（MB）。构建被 OOM kill 时可上调，NAS 内存紧张可下调到 3072
NODE_MAX_OLD_SPACE=4096

# 以下一般不用改
API_BASE=http://localhost/
VITE_PASSWORD_RSA_PUBLIC_KEY=

# 仅 static profile 使用
TYPEWORDS_STATIC_PORT=8080
