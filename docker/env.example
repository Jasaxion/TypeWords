# 复制到项目根目录的 .env 后使用：cp docker/env.example .env
# docker compose 会自动读取根目录的 .env

# 宿主机映射端口（SSR，默认）
TYPEWORDS_PORT=3000

# 站点对外访问地址（不要带结尾斜杠），用于生成绝对链接。
# 例：http://192.168.1.10:3000 或 https://words.example.com
ORIGIN=http://localhost:3000

# 部署在子路径时填写（需以 / 开头和结尾），根路径保持 /
NUXT_APP_BASE_URL=/

# 数据存放目录（宿主机路径，相对路径以 compose 文件所在目录为基准）
DATA_DIR=./data

# 官方词典目录（宿主机路径）。用下面的命令下载，约 430MB：
#   python3 scripts/fetch-dicts.py
# 只想要一部分可以按分类或体积过滤：
#   python3 scripts/fetch-dicts.py --category 中国考试 国际考试
#   python3 scripts/fetch-dicts.py --max-size 3
# 留空/目录不存在时，自动使用镜像内置的 CET4 + 新概念1
DICTS_DIR=./dicts

# 自建文章库的朗读音频目录（宿主机路径）。
# 抓来的网页文章没有真人配音，句子发音会回退到浏览器 TTS（机械音）。
# 用下面的命令合成后放到这里，就能像官方的新概念英语那样播真实音频：
#   python3 scripts/synth-article-audio.py --dict <词库json> --voice Ethan
# 留空/目录不存在时不影响启动，只是继续用浏览器 TTS
AUDIO_DIR=./audio

# 容器内运行身份，必须能写入上面的 DATA_DIR。
# 用 `id -u` / `id -g` 查看自己的 uid/gid 后填在这里。
# 群晖等 NAS 的普通用户通常不是 1000，务必确认。
PUID=1000
PGID=1000

# 构建阶段 Node 堆上限（MB）。构建被 OOM kill 时可上调，NAS 内存紧张可下调到 3072
NODE_MAX_OLD_SPACE=4096

# 以下一般不用改
API_BASE=http://localhost/
VITE_PASSWORD_RSA_PUBLIC_KEY=

# 仅 static profile 使用
TYPEWORDS_STATIC_PORT=8080
